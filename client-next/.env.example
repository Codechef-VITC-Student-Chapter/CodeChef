# Sanity (existing)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_TOKEN=

# Sanity — server-only write token used by the admin dashboard.
# Generate with "Editor" (write) permissions at https://www.sanity.io/manage
# Never prefix this with NEXT_PUBLIC_.
SANITY_WRITE_TOKEN=

# Admin dashboard (/admin) — exactly two admin accounts
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=

ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

# Secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=


# ─── Resend Email Service ─────────────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
# NEVER commit your real API key — keep it in .env.local only.
RESEND_API_KEY=

# IMPORTANT — Sender domain:
#   The testing domain "onboarding@resend.dev" can ONLY send to your own Resend account email.
#   To send to real applicants you MUST verify a custom domain:
#     1. Go to https://resend.com/domains → Add Domain
#     2. Add the DNS records Resend shows (SPF, DKIM, DMARC) to your DNS provider
#     3. Wait for verification (green checkmark in Resend dashboard)
#     4. Update this value: CodeChef VITC <recruitment@your-verified-domain.com>
RESEND_FROM_EMAIL=CodeChef VITC <onboarding@resend.dev>

# Optional: reply-to email address (applicants can reply here for support)
# RESEND_REPLY_TO=recruitment@your-verified-domain.com

# Default Fallback WhatsApp Group Link (used if Sanity link is not configured)
WHATSAPP_GROUP_LINK=https://chat.whatsapp.com/default-codechef-recruitment
